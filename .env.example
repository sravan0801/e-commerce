# Copy to .env for local (non-Docker) runs. docker-compose.yml sets its own values.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/storefront
SPRING_DATASOURCE_USERNAME=storefront
SPRING_DATASOURCE_PASSWORD=storefront
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_JWT_SECRET=dev-only-secret-change-me-please-at-least-32-bytes-long-000
APP_SEED_ENABLED=true
